# RailNexus Member B backend configuration
# Copy to .env and adjust.

# HTTP port for the Member B service
PORT=8787

# Real ABP base URL. When unset, the built-in mock ABP is used.
# ABP_BASE_URL=http://localhost:9000

# Feed source for the demo world state.
#   replay  — loop the bundled fixtures automatically (default)
#   http    — poll the real Member A feed (requires MEMBER_A_FEED_URL)
#   manual  — idle on boot; you drive the demo with POST /api/ingest
FEED_MODE=replay

# Member A live world-state feed URL (Day N-1 integration). Required when
# FEED_MODE=http.
# MEMBER_A_FEED_URL=http://localhost:9001/feed

# Polling interval for HTTP/live feed, in milliseconds
FEED_POLL_MS=2000